# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe subirse al repo (ver .gitignore).

# --- Base de datos (usada por docker-compose.yml) ---
POSTGRES_USER=companion
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_companion
# DATABASE_URL se arma automáticamente en docker-compose.yml a partir de las 3 variables de arriba.
# Si se corre el backend fuera de Docker, descomentar y completar:
# DATABASE_URL=postgresql://companion:changeme@localhost:5432/ai_companion

# --- LLM (ADR-010: OpenAI; por ejemplo, gpt-4o-mini) ---
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (ADR-009: Voyage AI) ---
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_DIMENSION=512

# --- STT (Deepgram) ---
STT_API_KEY=
STT_MODEL=nova-3

# --- TTS (ElevenLabs, voz preset Jessica) ---
TTS_API_KEY=
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# --- Frontend (usada por apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
